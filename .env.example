# The source chain is the chain that the light client will sync from.
NORI_SOURCE_CONSENSUS_HTTP_RPCS=
NORI_SOURCE_CHAIN_ID=1
NORI_SOURCE_EXECUTION_HTTP_RPCS=

# Source contract address.
NORI_TOKEN_BRIDGE_ADDRESS=

# Helios polling interval for new slots
NORI_HELIOS_POLLING_INTERVAL=

# Timeouts for how long the dry-run consensus and consensus-mpt validations runs are given before timing out
NORI_CONSENSUS_PROOF_INPUT_VALIDATION_TIMEOUT=
NORI_EXECUTION_PROOF_INPUT_VALIDATION_TIMEOUT=

# Rust logging level
NORI_LOG=info

# ============================================================================
# SP1 PROVER CONFIGURATION
# ============================================================================

# SP1_PROVER: Prover mode to use (REQUIRED)
# Options: mock, cpu, cuda, network
# - mock: Fast mock prover for testing (no real proof generation)
# - cpu: CPU-based prover for local proof generation
# - cuda: GPU-accelerated prover (requires CUDA support)
# - network: Use Succinct's network prover service
SP1_PROVER=mock

# SP1_PROOF_TYPE: Type of zero-knowledge proof to generate (REQUIRED)
# Options: plonk, groth16
# - plonk: PLONK proof system
# - groth16: Groth16 proof system 
SP1_PROOF_TYPE=plonk

# ============================================================================
# NETWORK MODE VARIABLES (Required when SP1_PROVER=network)
# ============================================================================

# SP1_NETWORK_PRIVATE_KEY: Private key for authenticating with the network prover(requester)
# Required when SP1_PROVER=network
SP1_NETWORK_PRIVATE_KEY=

# SP1_NETWORK_MODE: Network mode for the prover
# Options: mainnet, reserved
# Default: mainnet
# SP1_NETWORK_MODE=mainnet

# SP1_NETWORK_RPC_URL: RPC endpoint for the network prover
# Optional - defaults based on SP1_NETWORK_MODE:
# - Mainnet: https://rpc.mainnet.succinct.xyz
# - Reserved: https://rpc.production.succinct.xyz
# SP1_NETWORK_RPC_URL=


# ============================================================================
# NETWORK PROVER CONFIGURATION (Optional when SP1_PROVER=network)
# ============================================================================

# SP1_FULFILLMENT_STRATEGY: How proofs are fulfilled on the network
# Options: auction, hosted, reserved
# Default: auction (Mainnet), reserved (Reserved)
# SP1_FULFILLMENT_STRATEGY=auction

# SP1_AUCTION_TIMEOUT_SECS: Timeout for auction fulfillment in seconds
# Only used when SP1_FULFILLMENT_STRATEGY=auction
# Default: 30 seconds
# SP1_AUCTION_TIMEOUT_SECS=30

# SP1_MIN_AUCTION_PERIOD_SECS: Minimum time the auction stays open before settling
# The auction settles only after this period AND >= 1 bid is received.
# Only used when SP1_FULFILLMENT_STRATEGY=auction
# Recommended: 10-15 if you don't have strict latency requirements (better price discovery)
# Default: 1 second
# SP1_MIN_AUCTION_PERIOD_SECS=1

# SP1_MAX_PRICE_PER_PGU: The maximum amount of PROVE per PGU
# Only used when SP1_FULFILLMENT_STRATEGY=auction
# Default: ??? (2.0000 $PROVE)
# 212000000 (0.212 $PROVE) ??
# SP1_MAX_PRICE_PER_PGU=


# SP1_CYCLE_LIMIT: Maximum number of cycles for proof generation
# Defaults based on network mode: @TODO check
# - Mainnet: 1,000,000,000,000
# - Reserved: 100,000,000
# SP1_CYCLE_LIMIT=1000000000000

# SP1_GAS_LIMIT: Gas limit for proof generation @TODO check
# Default: 1,000,000,000 
# SP1_GAS_LIMIT=1000000000

# SP1_SKIP_SIMULATION: Skip simulation step before proof generation
# Options: true, false
# Default: false
# SP1_SKIP_SIMULATION=false

# SP1_TIMEOUT_SECS: Overall timeout for proof generation in seconds
# Default: 600 seconds
# SP1_TIMEOUT_SECS=600

# SP1_WHITELIST: Comma-separated list of prover addresses to whitelist @TODO check
# If not set, SDK uses recently reliable provers
# Example: 0x1234...,0x5678...,0x9abc...
# SP1_WHITELIST=

# SP1_WHITELIST_OPEN: Opt out of any whitelist - send an empty list to the prover network,
# meaning any prover can bid on the auction.
# Only meaningful when SP1_WHITELIST is NOT set, and mutually exclusive with SP1_WHITELIST.
# When unset (default), the SDK silently injects all recently reliable provers as the
# whitelist (and may retry with high-availability provers on auction failure).
# Setting this to true sends Some(vec![]) to the SDK, bypassing both behaviours.
# Options: true, false
# Default: false
# SP1_WHITELIST_OPEN=false

# SP1_WHITELIST_ADD_DEFAULT: When true, extends SP1_WHITELIST with the SDK default pool
# of recently reliable provers (get_provers_by_uptime, high_availability_only: false) -
# the same set the SDK would have injected if no whitelist was provided.
# Same shape as SP1_WHITELIST_ADD_HIGH_AVAILABILITY but the broader pool. Useful when you
# want to whitelist a specific prover AND keep the default fallback set as well. Both
# extension flags can be enabled together (their results are merged and deduplicated).
# Only applies when SP1_WHITELIST is provided.
# Options: true, false
# Default: false
# SP1_WHITELIST_ADD_DEFAULT=false

